generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  ID              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Email           String      @unique @db.VarChar(255)
  Password        String      @db.VarChar(255)
  FullName        String
  AvatarUrl       String?
  PhoneNumber     String      @unique @db.VarChar(255)
  Status          UserStatus  @default(ACTIVE)
  CreatedAt       DateTime    @default(now())
  UpdatedAt       DateTime    @default(now())
  Role            Role
  DeletedAt       DateTime?
  IsEmailVerified Boolean     @default(false)
  Candidates      Candidates?
  Recruiters      Recruiters?
}

model Recruiters {
  ID        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Position  String    @db.VarChar(255)
  DeletedAt DateTime?
  UserID    String    @unique @db.Uuid
  CompanyID String    @db.Uuid
  Jobs      Jobs[]
  Company   Companies @relation(fields: [CompanyID], references: [ID], onDelete: Cascade)
  User      Users     @relation(fields: [UserID], references: [ID], onDelete: Cascade)
}

model Candidates {
  ID             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ResumeUrl      String?
  Certifications String[]
  Bio            String?
  Level          Level
  DeletedAt      DateTime?
  UserID         String         @unique @db.Uuid
  Applications   Applications[]
  User           Users          @relation(fields: [UserID], references: [ID], onDelete: Cascade)
  JobFavorites   JobFavorites[]
}

model Companies {
  ID               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Name             String
  WebsiteUrl       String?
  LogoUrl          String?
  Description      String?
  CreatedAt        DateTime          @default(now())
  UpdatedAt        DateTime          @default(now())
  CompanyLocations CompanyLocation[]
  Recruiters       Recruiters[]
}

model CompanyLocation {
  ID          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  BranchName  String        @db.VarChar(255)
  Address     String        @db.VarChar(255)
  CreatedAt   DateTime      @default(now())
  UpdatedAt   DateTime      @default(now())
  DeletedAt   DateTime?
  CompanyID   String        @db.Uuid
  LocationID  String        @db.Uuid
  Company     Companies     @relation(fields: [CompanyID], references: [ID], onDelete: Cascade)
  Location    Locations     @relation(fields: [LocationID], references: [ID], onDelete: Cascade)
  JobBranches JobBranches[]
}

model Locations {
  ID               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Name             String
  Country          String            @db.VarChar(255)
  DeletedAt        DateTime?
  CompanyLocations CompanyLocation[]
}

model JobBranches {
  DeletedAt         DateTime?
  CompanyLocationID String          @db.Uuid
  JobID             String          @db.Uuid
  ID                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  CompanyLocation   CompanyLocation @relation(fields: [CompanyLocationID], references: [ID], onDelete: Cascade)
  Job               Jobs            @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

model Notification {
  ID        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Title     String
  Type      NotificationType
  DeletedAt DateTime?
}

model UserNotification {
  ID        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Content   String[]
  IsRead    Boolean   @default(false)
  CreatedAt DateTime  @default(now())
  DeletedAt DateTime?
}

model Jobs {
  ID              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Title           String
  Description     String?
  Address         String            @db.VarChar(255)
  Salary          String
  Vacancies       Int
  Type            JobType
  WorkingTimes    String
  Status          JobStatus         @default(PENDING)
  PostedAt        DateTime          @default(now())
  ExpiredAt       DateTime
  Benefits        String[]
  Level           Level
  Category        JobCategory
  DeletedAt       DateTime?
  RecruiterID     String            @db.Uuid
  Applications    Applications[]
  JobBranches     JobBranches[]
  JobDescriptions JobDescription[]
  JobFavorites    JobFavorites[]
  JobRequirements JobRequirements[]
  Recruiter       Recruiters        @relation(fields: [RecruiterID], references: [ID], onDelete: Cascade)
}

model Applications {
  ID          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ResumeUrl   String
  Status      ApplicationStatus
  AppliedAt   DateTime          @default(now())
  DeletedAt   DateTime?
  CandidateID String            @db.Uuid
  JobID       String            @db.Uuid
  Candidate   Candidates        @relation(fields: [CandidateID], references: [ID], onDelete: Cascade)
  Job         Jobs              @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

model JobDescription {
  ID          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Description String
  DeletedAt   DateTime?
  JobID       String    @db.Uuid
  Job         Jobs      @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

model JobRequirements {
  ID          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Requirement String
  DeletedAt   DateTime?
  JobID       String    @db.Uuid
  Job         Jobs      @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

model WorkExperiences {
  ID             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  CompanyName    String    @db.VarChar(255)
  CompanyLogoUrl String
  Position       String    @db.VarChar(255)
  StartDate      DateTime
  EndDate        DateTime?
  Descriptions   String[]
  Location       String
  JobType        JobType
}

model JobFavorites {
  ID          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  SavedAt     DateTime   @default(now())
  DeletedAt   DateTime?
  CandidateID String     @db.Uuid
  JobID       String     @db.Uuid
  Candidate   Candidates @relation(fields: [CandidateID], references: [ID], onDelete: Cascade)
  Job         Jobs       @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum Role {
  ADMIN     @map("admin")
  RECRUITER @map("recruiter")
  CANDIDATE @map("candidate")
}

enum Level {
  INTERN  @map("intern")
  FRESHER @map("fresher")
  MID     @map("mid")
  JUNIOR  @map("junior")
  SENIOR  @map("senior")
}

enum NotificationType {
  CANDIDATE_APPLICATION_APPROVED @map("candidate_application_approved")
  CANDIDATE_APPLICATION_REJECTED @map("candidate_application_rejected")
  RECRUITER_JOB_APPROVED         @map("recruiter_job_approved")
  RECRUITER_JOB_REJECTED         @map("recruiter_job_rejected")
  RECRUITER_NEW_APPLICATION      @map("recruiter_new_application")
  ADMIN_NEW_JOB_POST             @map("admin_new_job_post")
}

enum JobType {
  PART_TIME  @map("part_time")
  FULL_TIME  @map("full_time")
  REMOTE     @map("remote")
  FREE_LANCE @map("free_lance")
}

enum JobStatus {
  OPEN     @map("open")
  CLOSED   @map("closed")
  PENDING  @map("pending")
  REJECTED @map("rejected")
}

enum JobCategory {
  FULL_STACK        @map("full_stack")
  FRONT_END         @map("front_end")
  BACK_END          @map("back_end")
  MOBILE            @map("mobile")
  SOFTWARE_ENGINEER @map("software_engineer")
  DEVOPS            @map("devops")
  DATA_SCIENTIST    @map("data_scientist")
  AI_ENGINEER       @map("ai_engineer")
  GAME_DEVELOPER    @map("game_developer")
  CYBER_SECURITY    @map("cyber_security")
  UI_UX_DESIGNER    @map("ui_ux_designer")
  QA_TESTER         @map("qa_tester")
  EMBEDDED_ENGINEER @map("embedded_engineer")
  OTHER             @map("other")
}

enum ApplicationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")
}
