generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  ID                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Email             String             @unique @db.VarChar(255)
  Password          String             @db.VarChar(255)
  FullName          String
  AvatarUrl         String?
  PhoneNumber       String             @unique @db.VarChar(255)
  Status            UserStatus         @default(active)
  CreatedAt         DateTime           @default(now())
  UpdatedAt         DateTime           @default(now())
  Role              Role
  DeletedAt         DateTime?
  IsEmailVerified   Boolean            @default(false)
  Candidates        Candidates?
  Recruiters        Recruiters?
  UserNotifications UserNotification[]
}

model Recruiters {
  ID                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Position          String    @db.VarChar(255)
  DeletedAt         DateTime?
  UserID            String    @unique @db.Uuid
  Jobs              Jobs[]
  User              Users     @relation(fields: [UserID], references: [ID], onDelete: Cascade)
  CompanyLocationID String    @unique @db.Uuid

  CompanyLocation CompanyLocation @relation(fields: [CompanyLocationID], references: [ID], onDelete: Cascade)
}

model Candidates {
  ID              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ResumeUrl       String?
  Certifications  String[]
  Bio             String?
  Level           Level
  DeletedAt       DateTime?
  UserID          String            @unique @db.Uuid
  Applications    Applications[]
  User            Users             @relation(fields: [UserID], references: [ID], onDelete: Cascade)
  JobFavorites    JobFavorites[]
  WorkExperiences WorkExperiences[]
}

model Companies {
  ID               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Name             String
  WebsiteUrl       String?
  LogoUrl          String?
  Description      String?
  CreatedAt        DateTime          @default(now())
  UpdatedAt        DateTime          @default(now())
  CompanyLocations CompanyLocation[]
}

model CompanyLocation {
  ID         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  BranchName String       @db.VarChar(255)
  Address    String       @db.VarChar(255)
  CreatedAt  DateTime     @default(now())
  UpdatedAt  DateTime     @default(now())
  DeletedAt  DateTime?
  CompanyID  String       @db.Uuid
  LocationID String       @db.Uuid
  Company    Companies    @relation(fields: [CompanyID], references: [ID], onDelete: Cascade)
  Location   Locations    @relation(fields: [LocationID], references: [ID], onDelete: Cascade)
  Recruiters Recruiters[]

  @@unique([BranchName, CompanyID])
}

model Locations {
  ID               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Name             String
  Country          String            @db.VarChar(255)
  DeletedAt        DateTime?
  CompanyLocations CompanyLocation[]
}

model Notification {
  ID                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Title             String
  Type              NotificationType
  DeletedAt         DateTime?
  UserNotifications UserNotification[]
}

model UserNotification {
  ID        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Content   String[]
  IsRead    Boolean   @default(false)
  CreatedAt DateTime  @default(now())
  DeletedAt DateTime?

  UserID         String @db.Uuid
  NotificationID String @db.Uuid

  User         Users        @relation(fields: [UserID], references: [ID], onDelete: Cascade)
  Notification Notification @relation(fields: [NotificationID], references: [ID], onDelete: Cascade)
}

model Jobs {
  ID              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Title           String
  Description     String?
  Address         String            @db.VarChar(255)
  Salary          String
  Vacancies       Int
  Type            JobType
  WorkingTimes    String
  Status          JobStatus         @default(pending)
  PostedAt        DateTime          @default(now())
  ExpiredAt       DateTime
  Level           Level
  DeletedAt       DateTime?
  RecruiterID     String            @db.Uuid
  Applications    Applications[]
  JobDescriptions JobDescription[]
  JobFavorites    JobFavorites[]
  JobRequirements JobRequirements[]
  JobBenefits     JobBenefits[]
  Recruiter       Recruiters        @relation(fields: [RecruiterID], references: [ID], onDelete: Cascade)
  JobCategories   JobCategories[]
}

model Applications {
  ID          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ResumeUrl   String
  Status      ApplicationStatus
  AppliedAt   DateTime          @default(now())
  DeletedAt   DateTime?
  CandidateID String            @db.Uuid
  JobID       String            @db.Uuid
  Candidate   Candidates        @relation(fields: [CandidateID], references: [ID], onDelete: Cascade)
  Job         Jobs              @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

model JobDescription {
  ID          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Description String
  DeletedAt   DateTime?
  JobID       String    @db.Uuid
  Job         Jobs      @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

model JobRequirements {
  ID          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Requirement String
  DeletedAt   DateTime?
  JobID       String    @db.Uuid
  Job         Jobs      @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

model JobBenefits {
  ID        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Benefit   String
  DeletedAt DateTime?
  JobID     String    @db.Uuid
  Job       Jobs      @relation(fields: [JobID], references: [ID], onDelete: Cascade)
}

model WorkExperiences {
  ID             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  CompanyName    String    @db.VarChar(255)
  CompanyLogoUrl String
  Position       String    @db.VarChar(255)
  StartDate      DateTime
  EndDate        DateTime?
  Descriptions   String[]
  Location       String
  JobType        JobType
  CandidateID    String    @db.Uuid

  Candidate Candidates @relation(fields: [CandidateID], references: [ID], onDelete: Cascade)
}

model JobFavorites {
  ID          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  SavedAt     DateTime   @default(now())
  DeletedAt   DateTime?
  CandidateID String     @db.Uuid
  JobID       String     @db.Uuid
  Candidate   Candidates @relation(fields: [CandidateID], references: [ID], onDelete: Cascade)
  Job         Jobs       @relation(fields: [JobID], references: [ID], onDelete: Cascade)

  @@unique([CandidateID, JobID])
}

model JobCategories {
  CategoryID String @db.Uuid
  JobID      String @db.Uuid

  Job      Jobs       @relation(fields: [JobID], references: [ID], onDelete: Cascade)
  Category Categories @relation(fields: [CategoryID], references: [ID], onDelete: Cascade)

  @@id([CategoryID, JobID])
  @@index([CategoryID, JobID])
}

model Categories {
  ID            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  CategoryName  String          @unique
  CreatedAt     DateTime        @default(now())
  UpdatedAt     DateTime        @default(now())
  DeletedAt     DateTime?
  JobCategories JobCategories[]
}

enum UserStatus {
  active
  inactive
}

enum Role {
  admin
  recruiter
  candidate
}

enum Level {
  intern
  fresher
  mid
  junior
  senior
}

enum NotificationType {
  candidate_application_approved
  candidate_application_rejected
  recruiter_job_approved
  recruiter_job_rejected
  recruiter_new_application
  admin_new_job_post
}

enum JobType {
  part_time
  full_time
  remote
  free_lance
}

enum JobStatus {
  open
  closed
  pending
  rejected
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}
